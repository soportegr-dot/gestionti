DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upfr_gestion_ti
DB_USERNAME=usuario_mysql
DB_PASSWORD=cambiar_clave_segura

# PARÁMETROS DEL SISTEMA TI
